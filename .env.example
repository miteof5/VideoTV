DATABASE_URL="file:./dev.db"

# 生成产物的本地存储根目录（相对项目根）
STORAGE_DIR="./storage"

# 模型 Provider：留空（默认）| mock
#   mock = 即使配了 key 也只用演示模型。调界面不想烧额度时用
MODEL_PROVIDER=""

# ---------------------------------------------------------------------------
# 阿里云百炼
# ---------------------------------------------------------------------------
# 留空则只启用内置演示模型，整条链路照样能跑通。
# 填上之后重启 dev 和 worker —— 两个进程各自读这个文件，缺一不可。
# 控制台地址：https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=""

# 干跑：请求体拼接完成后停住，不发出去，也不花钱。
# 设成 1 之后点运行，运行日志里会出现「本该发出去的请求」，
# 用来核对模型名、图片尺寸、上游图有没有真的塞进去。
PROVIDER_DRY_RUN="0"
