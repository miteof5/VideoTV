# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# 模板文件只有空值，公开以说明需要配哪些变量
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# database（Prisma 7 按 cwd 解析，db 文件在项目根）
/dev.db
/dev.db-journal
*.db

# generated assets
/storage

# E2E 的临时素材与截图（脚本自己造，不该进版本库）
/.e2e-tmp

# 项目内的协作记忆与决策日志（本地私有，不进版本库）
/.workbuddy
/DECISIONS.md

# 设计基准文档（本地保留，不公开）
/ARCHITECTURE.md
